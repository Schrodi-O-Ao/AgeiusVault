# SECURITY WARNING: Never commit this file with real credentials!
# This is a template only. Copy to .env and fill with real values.
# Generate secure random values for all secrets and passwords.

# Database
# Default password for local development; change in production.
# Generate strong password with: openssl rand -base64 32
DATABASE_URL=postgresql+asyncpg://aegisvault_user:aegisvault_dev_password_CHANGE_ME@localhost:5433/aegisvault

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Application secrets
# Generate these with: python -c "import secrets; print(secrets.token_hex(32))"
# These must be different random values; never reuse the same secret.
SERVER_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_SECRETS_TOKEN_HEX_32
TOTP_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS_FROM_SECRETS_TOKEN_HEX_32
JWT_SECRET=REPLACE_WITH_YET_ANOTHER_64_HEX_CHARACTERS_FROM_SECRETS_TOKEN_HEX_32

# Security configuration
# PBKDF2 iterations (increase for better security, decrease for performance)
PBKDF2_ITERATIONS=200000
PBKDF2_OTP_ITERATIONS=10000

# Token expiration times (in seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=7
PARTIAL_TOKEN_EXPIRE_SECONDS=300
STEP_UP_TOKEN_EXPIRE_SECONDS=300

# OTP expiration times
EMAIL_OTP_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=15
ACTION_NONCE_EXPIRE_MINUTES=10

# Security thresholds
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_HOURS=1
MAX_OTP_ATTEMPTS=5
MAX_BULK_APPROVAL_REQUESTS=10

# RSA key size (3072 recommended for production, 2048 minimum)
RSA_KEY_SIZE=3072

# Request size limits
MAX_REQUEST_SIZE_BYTES=10485760

# Rate limiting (per-IP)
RATE_LIMIT_REQUESTS_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=600

# Rate limiting (per-user)
RATE_LIMIT_USER_REQUESTS_PER_WINDOW=100
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_USER_BLOCK_SECONDS=300

# SMTP configuration
# For Gmail, use an App Password (not your regular password)
# Get one here: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# CORS configuration
# Specify allowed origins explicitly. For local development:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# For production, use your actual domain:
# CORS_ORIGINS=["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Development settings
DEBUG=false
